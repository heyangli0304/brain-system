@echo off
chcp 65001 >nul
echo ============================================================
echo 算网大脑调度系统 - 停止脚本
echo ============================================================
echo.

echo [1/2] 停止所有容器...
docker-compose down

echo.
echo [2/2] 清理资源...
echo.

set /p clean_volumes="是否删除数据卷？(y/n): "
if /i "%clean_volumes%"=="y" (
    echo 删除数据卷...
    docker-compose down -v
)

echo.
echo ============================================================
echo 服务已停止
echo ============================================================
pause
